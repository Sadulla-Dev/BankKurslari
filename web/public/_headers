# Response headers for the static site (Cloudflare Workers static assets).
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff

# The font files never change; css and js are always requested with ?v=<content hash> (see build.mjs).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable
/pages.css
  Cache-Control: public, max-age=31536000, immutable
/shared.js
  Cache-Control: public, max-age=31536000, immutable
/app.js
  Cache-Control: public, max-age=31536000, immutable
/calc.js
  Cache-Control: public, max-age=31536000, immutable
/wallet.js
  Cache-Control: public, max-age=31536000, immutable
/ev.js
  Cache-Control: public, max-age=31536000, immutable
/app-link.js
  Cache-Control: public, max-age=31536000, immutable
# The service worker must be re-checked on every visit, or a new version would never reach anyone.
/sw.js
  Cache-Control: no-cache
/bank-logos/*
  Cache-Control: public, max-age=604800
