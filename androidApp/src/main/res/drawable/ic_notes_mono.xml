        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-10">
        <!-- back note: the part not covered by the front one -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M28,33H60a4,4 0,0 1,4 4V47H37V57H28a4,4 0,0 1,-4 -4V37a4,4 0,0 1,4 -4zM33.500,39a4,4 0,1 0,0 8a4,4 0,1 0,0 -8z" />
