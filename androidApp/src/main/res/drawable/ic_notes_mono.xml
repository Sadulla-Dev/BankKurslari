        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M44,50H76a4,4 0,0 1,4 4V70a4,4 0,0 1,-4 4H44a4,4 0,0 1,-4 -4V54a4,4 0,0 1,4 -4zM60,55.500a6.500,6.500 0,1 0,0 13a6.500,6.500 0,1 0,0 -13z" />
    </group>
